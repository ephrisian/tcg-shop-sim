{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcg-shop-sim.invalid/schemas/product-packaging.schema.json",
  "title": "TCG Shop Simulator Product Packaging Update",
  "type": "object",
  "required": ["schemaVersion", "packageType", "game", "set", "products"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageType": { "const": "product-packaging" },
    "game": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["pack", "box"] },
          "price": { "type": "number", "minimum": 0 },
          "image": { "type": "string", "minLength": 1 },
          "cardsPerPack": { "type": "integer", "minimum": 1 },
          "packsPerBox": { "type": "integer", "minimum": 1 },
          "packProductId": { "type": "string" },
          "runSize": { "type": "integer", "minimum": 1 },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rarity", "count"],
              "properties": {
                "rarity": {
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  ]
                },
                "count": { "type": "integer", "minimum": 1 },
                "isFoil": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "pullRates": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
