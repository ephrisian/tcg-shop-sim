{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcg-shop-sim.invalid/schemas/set-package.schema.json",
  "title": "TCG Shop Simulator Set Package",
  "type": "object",
  "required": ["schemaVersion", "game", "set", "card_data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "game": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "company": { "type": "string" },
        "runSize": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "card_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cardId"],
        "properties": {
          "cardId": { "type": "string" },
          "marketPrice": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": { "type": ["number", "string", "boolean", "null"] }
      }
    },
    "image": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cardId", "path"],
        "properties": {
          "cardId": { "type": "string" },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["pack", "box"] },
          "image": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "minimum": 0 },
          "cardsPerPack": { "type": "integer", "minimum": 1 },
          "packsPerBox": { "type": "integer", "minimum": 1 },
          "packProductId": { "type": "string" },
          "runSize": { "type": "integer", "minimum": 1 },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rarity", "count"],
              "properties": {
                "rarity": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                "count": { "type": "integer", "minimum": 1 },
                "isFoil": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "pullRates": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
        },
        "additionalProperties": true
      }
    },
    "redemptions": {
      "type": "object",
      "required": ["caseCount", "tiers"],
      "properties": {
        "caseCount": { "type": "integer", "minimum": 1 },
        "packsPerCase": { "type": "integer", "minimum": 1 },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "quantity", "prizeType", "prizeId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 0 },
              "prizeType": { "enum": ["card", "binder"] },
              "prizeId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "credits": { "type": ["object", "array"] }
  },
  "additionalProperties": false
}
