{
  "name": "tcg-shop-sim",
  "description": "A trading-card shop simulator desktop game.",
  "author": "TCG Shop Simulator contributors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:prepare": "node scripts/generate-settings.mjs && node scripts/compile-set-packages.mjs",
    "predev": "npm run dev:prepare",
    "build:prepare": "node scripts/generate-settings.mjs && node scripts/compile-set-packages.mjs",
    "prebuild": "npm run build:prepare",
    "build": "tsc --noEmit && vite build",
    "test": "node --test && node developer-tools/validation-selftest.cjs",
    "validate:set": "node scripts/validate-set-package.mjs",
    "author": "node scripts/dev-tool-server.mjs",
    "fetch:art": "node scripts/fetch-set-art.mjs",
    "fetch:marvel": "node scripts/marvel-tcg-scraper.mjs",
    "export:set": "node scripts/export-set-package.mjs",
    "world:grid": "node developer-tools/world-grid-cli.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.tcgshopsim.desktop",
    "productName": "TCG Shop Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "compression": "store",
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
